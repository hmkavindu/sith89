# OpenRouter API Configuration (Recommended)
# Get your API key from: https://openrouter.ai/keys
# OpenRouter allows access to multiple AI models (GPT-4, Claude, etc.)

# Required: Your OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Optional: Override default OpenRouter model
# Default: openai/gpt-4o-mini
# Other options: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-pro, etc.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: OpenRouter metadata (for analytics)
# OPENROUTER_REFERER=http://localhost:8888
# OPENROUTER_TITLE=Abhidhamma Chatbot

# Optional: Groq API Configuration (Fallback)
# Get your API key from: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Override server port
# Default: 8888
# PORT=8888
























